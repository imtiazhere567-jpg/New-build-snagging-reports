# Copy to .env.local for local development. On Vercel, add these under Project -> Settings -> Environment Variables.

# ---- Mode ----
# demo = seeded sample data in each visitor's browser, any account opens from the login dropdown (no keys needed)
# live = real data in Postgres, sign-in by emailed link
NEXT_PUBLIC_APP_MODE=demo

# ---- Database (live mode) ----
# Vercel Postgres / Neon sets DATABASE_URL (or POSTGRES_URL) for you when you connect the database.
# Tables are created automatically on first use.
DATABASE_URL=

# ---- Sign-in (live mode) ----
# Long random string used to sign session cookies. Generate one with:  openssl rand -base64 48
AUTH_SECRET=
# Asked once on /setup to create the contractor (admin) account. Pick any secret phrase.
SETUP_KEY=
# Public address of the site, used in email links (e.g. https://snagsnap.vercel.app). Optional on Vercel.
APP_URL=

# ---- Email (live mode) ----
# Without Resend, emails are saved in the contractor's Inbox with a personal sign-in link to share by hand.
RESEND_API_KEY=
EMAIL_FROM="Your Company <snags@yourdomain.co.uk>"

# ---- Claude AI (photo analysis) ----
# With an Anthropic API key, real Claude analyses every photo. Without one, the built-in demo AI is used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Local only: use the Claude Code program on this computer (your Claude subscription) instead of an API key.
# AI_PROVIDER=claude-code
# CLAUDE_CODE_PATH=C:Usersyou.localinclaude.exe
